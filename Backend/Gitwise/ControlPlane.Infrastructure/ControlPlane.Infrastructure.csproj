    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\CommonResources\CommonResources.csproj" />
      <ProjectReference Include="..\ControlPlane.Application\ControlPlane.Application.csproj" />
    </ItemGroup>

</Project>
